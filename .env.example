# ==============================================================================
# ADALAT-PULSE: Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# Server Runtime
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./data/adalat_pulse.db

# External Integrations
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_TABLE_NAME=Courtroom Telemetry

SLACK_WEBHOOK_URL=your_slack_incoming_webhook_url
SLACK_CHANNEL=#all-adalat-pulse-alerts

LINEAR_API_KEY=your_linear_api_key
LINEAR_TEAM_ID=your_linear_team_id
LINEAR_TEAM_KEY=ALL

# Koyal ASR Telemetry Threshold Boundaries
PACKET_LOSS_CRITICAL_PCT=2.0
PACKET_LOSS_DEGRADED_PCT=0.5
LATENCY_CRITICAL_MS=300.0
LATENCY_DEGRADED_MS=120.0
JITTER_CRITICAL_MS=40.0
JITTER_DEGRADED_MS=15.0
WS_RTT_CRITICAL_MS=350.0
WS_RTT_DEGRADED_MS=150.0
MIN_MIC_SAMPLE_RATE_HZ=16000
SNR_CRITICAL_DB=12.0
SNR_DEGRADED_DB=20.0
